PORT=5000
# Set these in a secret manager; never commit populated values.
DATABASE_URL="postgresql://USER:REDACTED@HOST:6543/postgres?pgbouncer=true&schema=yegna"
DIRECT_URL="postgresql://USER:REDACTED@HOST:5432/postgres?schema=yegna"
JWT_SECRET="GENERATE_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
# Required only for the one-time, explicit admin bootstrap command.
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_INITIAL_DISPLAY_NAME=""
# Set to the exact deployed admin web origin, e.g. https://<project>.pages.dev
ADMIN_WEB_ORIGIN=""
# Optional email delivery configuration; required to send real verification emails.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
BACKEND_PUBLIC_URL=""
CLIENT_APP_URL=""
